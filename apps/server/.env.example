# Independent SIGILS WebSocket relay
HOST=0.0.0.0
PORT=3000
# Match the upstream relay's defaults unless you have a reason to change them.
IDLE_TIMEOUT_MS=600000
OUTBOX_TIMEOUT_MS=10000
MAX_PAYLOAD_BYTES=104857600
# Optional comma-separated browser origins, e.g. https://editor.example.com
# Leave empty to allow any Origin (useful for CC:Tweaked clients without Origin).
ALLOWED_ORIGINS=
